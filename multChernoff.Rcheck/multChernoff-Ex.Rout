> library('multChernoff')
> 
> base::assign(".oldSearch", base::search(), pos = 'CheckExEnv')
> base::assign(".old_wd", base::getwd(), pos = 'CheckExEnv')
> cleanEx()
> nameEx("criticalValue")
> ### * criticalValue
> 
> flush(stderr()); flush(stdout())
> 
> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: criticalValue
> ### Title: Critical value x such that P(LRT > x) <= p
> ### Aliases: criticalValue
> 
> ### ** Examples
> 
> n <- 1:40
> crit <- sapply(n, function(.n) criticalValue(20, .n, p=0.01))
> plot(n, crit)
> abline(h=qchisq(0.01, df=20-1, lower.tail = FALSE)) # standard chi-square asymptotic
> criticalValue(10, 40, p=0.05)
[1] 30.77278
> 
> 
> 
> base::assign(".dptime", (proc.time() - get(".ptime", pos = "CheckExEnv")), pos = "CheckExEnv")
> base::cat("criticalValue", base::get(".format_ptime", pos = 'CheckExEnv')(get(".dptime", pos = "CheckExEnv")), "\n", file=base::get(".ExTimings", pos = 'CheckExEnv'), append=TRUE, sep="\t")
> cleanEx()
> nameEx("tailProbBound")
> ### * tailProbBound
